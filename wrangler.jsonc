{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peniel",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_BASE_URL": "https://peniel.godstimesml.workers.dev/",
    "WHATSAPP_MODE": "disabled",
  },
}
